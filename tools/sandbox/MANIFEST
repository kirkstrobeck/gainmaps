# --- touched, not owned -----------------------------------------------------
manage   tools/sandbox/ORIGIN.md            # generated: repo, ref, commit
manage   tools/sandbox/sandbox.conf.new     # generated: incoming defaults
manage   tools/sandbox/sandbox.local.conf   # yours, machine-local, gitignored
manage   tools/sandbox/.cache               # live credentials and run state
manage   tools/sandbox/.install-hashes      # generated: replace-file hashes for drift detection
manage   tools/sandbox/outer-gate-deny.d       # project deny hooks; contents survive updates
manage   tools/sandbox/outer-write-gate-deny.d # project write-gate deny hooks; contents survive updates
manage   .claude/settings.json              # PreToolUse gates merged in
manage   .cursor/hooks.json                 # sandbox hooks merged in
manage   .gitignore                         # credential paths appended
