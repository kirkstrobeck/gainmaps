#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REPO_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)"
PKG_DIR="$REPO_ROOT/packages/gainmap"
CLI="$PKG_DIR/dist/cli.js"

if [ ! -d "$PKG_DIR/node_modules/sharp" ]; then
  echo "gainmap-mp4: local dependencies are missing. From the repo, run: pnpm install --filter gainmap" >&2
  exit 2
fi

if [ ! -f "$CLI" ]; then
  echo "gainmap-mp4: built CLI is missing. From the repo, run: pnpm --filter gainmap build" >&2
  exit 2
fi

if ! command -v ffmpeg >/dev/null 2>&1; then
  echo "gainmap-mp4: MP4 conversion requires ffmpeg. Install it with: brew install ffmpeg" >&2
  exit 2
fi

exec node "$CLI" --offline "$@"
