{
  "name": "gainmap",
  "version": "1.1.0",
  "description": "Convert images to Ultra HDR JPEG gain maps",
  "license": "MIT",
  "author": "Kirk Strobeck <kirk@strobeck.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/kirkstrobeck/gainmaps.com.git",
    "directory": "packages/gainmap"
  },
  "homepage": "https://www.gainmaps.com",
  "bugs": "https://github.com/kirkstrobeck/gainmaps.com/issues",
  "type": "module",
  "bin": {
    "gainmap": "./dist/cli.js"
  },
  "files": [
    "dist",
    "install.sh",
    "test/fixtures",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "exports": {
    ".": "./dist/cli.js",
    "./encode": "./dist/encode.js"
  },
  "imports": {
    "#src/*": "./dist/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "tsc -p tsconfig.lib.json && vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hdrify": "^0.12.1",
    "heic-decode": "^2.1.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
