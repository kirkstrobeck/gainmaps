{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "rewriteRelativeImportExtensions": false,
    "paths": {
      "#src/*": [
        "./src/*"
      ]
    },
    "customConditions": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
